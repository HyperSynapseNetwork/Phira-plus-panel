{
  "name": "phira-plus-panel",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "description": "Phira+ V3 Panel — admin/operations UI (Nuxt 3 SPA, ssr:false).",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "vue-tsc": "nuxt prepare && vue-tsc --noEmit",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:noindex": "vitest run tests/noindex.spec.ts",
    "test:error-i18n": "ERROR_LOCALE_DIR=i18n ERROR_SOURCE_DIR=. node scripts/check-error-i18n.mjs",
    "test:design-contract": "node scripts/check-design-contract.mjs",
    "test:product-copy": "node scripts/check-product-copy.mjs",
    "test:runtime-semantics": "node scripts/check-template-shadow.mjs"
  },
  "dependencies": {
    "@formkit/auto-animate": "0.10.0",
    "@heroui/styles": "3.2.4",
    "@nuxt/image": "2.1.0",
    "@nuxtjs/seo": "5.3.12",
    "@pinia/nuxt": "1.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/vue-virtual": "3.13.35",
    "@vueuse/nuxt": "14.4.0",
    "echarts": "6.1.0",
    "nuxt": "3.21.11",
    "pinia": "4.0.2",
    "tailwindcss": "4.3.3",
    "vue": "3.5.41",
    "vue-echarts": "8.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@types/node": "22.20.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.8.1",
    "happy-dom": "20.11.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  }
}
