# Phira+ Panel — environment template (copy to .env for local dev)
#
# PPB REST base URL (frozen cross-repo contract). Requests are credentialed
# (credentials: 'include') so PPB must allow exact Origin
# `http://localhost:3000` (dev) / `https://panel-phira.htadiy.com` (prod).
NUXT_PUBLIC_API_BASE=https://api-phira.htadiy.com

# Local dev can point at a different PPB instance:
# NUXT_PUBLIC_API_BASE=http://localhost:8000
